<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#E0E0E0"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Batas Peringatan Budget"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notifikasi dikirim saat pengeluaran mencapai batas ini"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="24dp"/>

    <!-- Pilihan % -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/btn_60"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="60%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_normal"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/btn_70"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="70%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_normal"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/btn_80"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="80%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_normal"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/btn_90"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="90%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_normal"
            android:textColor="@color/text_secondary"/>

    </LinearLayout>

    <TextView
        android:id="@+id/btn_bs_tutup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Tutup"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"/>

</LinearLayout>